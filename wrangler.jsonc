// Cloudflare (Workers com arquivos estáticos, o sucessor do Pages). Deploy: `npm run deploy`.
{
  "name": "rock-n-roll-racing-3d",
  "compatibility_date": "2026-09-21",
  // só /api/* passa pelo worker (credenciais TURN do jogo online); o resto é arquivo estático
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    // PWA: páginas desconhecidas caem no index.html
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
